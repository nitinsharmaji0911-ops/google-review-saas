# ==============================================================================
# REVIEW SAAS PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your values
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION SETTINGS
# ------------------------------------------------------------------------------
# The public URL where this instance is hosted (e.g. https://yourdomain.com or http://localhost:3000)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Secret key for JWT session encryption (generate a random 32+ char string in production)
JWT_SECRET="your-secure-random-jwt-secret-key-change-this"

# Super Admin email addresses (comma-separated, has access to /admin-vault)
ADMIN_EMAILS="admin@yourdomain.com"

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Local SQLite (Default, requires zero setup):
DATABASE_URL="file:./dev.db"

# Or Production PostgreSQL (Supabase / Neon / AWS RDS / Self-hosted):
# DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/[DB_NAME]?schema=public"

# ------------------------------------------------------------------------------
# 3. AI REVIEW GENERATION (Google Gemini)
# ------------------------------------------------------------------------------
# Free tier API key from https://aistudio.google.com
# If omitted, the app will automatically fall back to the built-in Smart NLP Engine!
GEMINI_API_KEY=""

# ------------------------------------------------------------------------------
# 4. PAYMENT GATEWAY (Razorpay)
# ------------------------------------------------------------------------------
# Leave empty or set to "rzp_test_placeholder" to enable instant built-in Mock Payment mode for testing!
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# ------------------------------------------------------------------------------
# 5. TRANSACTIONAL EMAIL (SMTP)
# ------------------------------------------------------------------------------
# Used for sending password reset links and customer negative feedback alerts
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="\"Review SaaS\" <noreply@yourdomain.com>"

# ------------------------------------------------------------------------------
# 6. FIREBASE CLOUD & AUTH (Optional)
# ------------------------------------------------------------------------------
# Only needed if you want Google OAuth button and Firebase cloud synchronization
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
FIREBASE_PROJECT_ID=""
